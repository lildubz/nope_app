{
    "java.configuration.updateBuildConfiguration": "interactive",
    // Flutter runs Gradle itself for Android builds; stop the Java extension
    // from importing android/ and the plugin projects on its own (which
    // throws errors like flutter_timezone's MavenPlugin failure).
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": false,
    // Flutter hides its "web-server" device by default, and the
    // "preview in VS Code" launch config needs it.
    "dart.flutterShowWebServerDevice": "always"
}
